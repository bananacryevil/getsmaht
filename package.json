{
  "name": "getsmaht",
  "private": true,
  "version": "1.0.0",
  "description": "30-Day Problem-Solving Tracker",
  "author": "Bryan <bryan@example.com>",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "ELECTRON_START_URL=http://localhost:5173",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.bryan.getsmaht",
    "productName": "Getsmaht Tracker",
    "files": [
      "dist/**/*",
      "main.js",
      "window-state.js",
      "preload.cjs",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": false
    }
  },
  "dependencies": {
    "@blocknote/code-block": "^0.41.1",
    "@blocknote/core": "^0.41.1",
    "@blocknote/mantine": "^0.41.1",
    "@blocknote/react": "^0.41.1",
    "@tailwindcss/vite": "^4.1.13",
    "@uiw/react-markdown-preview": "^5.1.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.2.0",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
